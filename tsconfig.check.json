{
  "include": ["./src"],
  "exclude": ["./src/**/*.test.ts", "./src/**/*.spec.ts", "./src/components/ui"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    // Incremental: a second run only re-checks what changed, so the type
    // check is fast on a working tree instead of re-reading every file.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.check.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
