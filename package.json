{
  "name": "manufacturing-erp",
  "version": "1.0.43",
  "description": "Manufacturing ERP — Full-featured desktop ERP for inventory, purchases, sales, processing, and accounting management.",
  "license": "MIT",
  "homepage": "https://github.com/beingadil/manufacturing-erp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingadil/manufacturing-erp.git"
  },
  "bugs": {
    "url": "https://github.com/beingadil/manufacturing-erp/issues",
    "email": "beingadil@users.noreply.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "erp",
    "manufacturing",
    "inventory",
    "accounting",
    "sqlite",
    "electron",
    "react",
    "typescript",
    "offline-first",
    "desktop-app"
  ],
  "author": "beingadil <https://github.com/beingadil>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "echo 'Do not use this command, only use lint to check'",
    "build": "echo 'Do not use this command, only use lint to check'",
    "lint": "bash scripts/lint.sh",
    "deadcode": "bash scripts/deadcode.sh",
    "test": "vitest run",
    "electron:dev": "vite build && electron .",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/rebuild": "^4.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bmapgl": "^0.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/video-react": "^0.15.8",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.4",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-intersect": "^3.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "~7.0.2",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "video-react": "^0.16.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.manufacturing.erp",
    "productName": "Manufacturing ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/*.iobj",
      "!node_modules/better-sqlite3/build/Release/*.ipdb",
      "!node_modules/better-sqlite3/build/Release/*.pdb",
      "!node_modules/better-sqlite3/build/Release/*.lib",
      "!node_modules/better-sqlite3/build/Release/*.exp",
      "!node_modules/better-sqlite3/build/Release/test_extension.*",
      "!node_modules/better-sqlite3/build/deps/**",
      "!node_modules/better-sqlite3/build/*.vcxproj*",
      "!node_modules/better-sqlite3/build/*.sln",
      "!node_modules/better-sqlite3/build/config.gypi",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manufacturing ERP",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "installerHeaderIcon": "public/favicon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "beingadil",
        "repo": "manufacturing-erp",
        "releaseType": "release"
      }
    ]
  }
}
