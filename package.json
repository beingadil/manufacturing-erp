  "build": {
    "appId": "com.manufacturing.erp",
    "productName": "Manufacturing ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manufacturing ERP"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "beingadil",
        "repo": "manufacturing-erp",
        "releaseType": "release"
      }
    ]
  }
